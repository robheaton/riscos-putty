# riscos-putty top-level Makefile.
#
#   make core       compile the portable PuTTY core for RISC OS (objects + libputty.a)
#   make plink      link the console bring-up tool
#   make clean
#
# The RISC OS build uses GCCSDK's old GCC 4.7 toolchain with the Shared C
# Library (-mlibscl): binaries link straight to AIF, need no extra modules, and
# -march=armv4 keeps them runnable both on RPCEmu (StrongARM) and on ARMv7/v8
# hardware such as the Raspberry Pi.
#
# The PuTTY sources are compiled straight from the unpacked upstream tree; the
# source lists below are transcribed from upstream's CMakeLists.txt files.

V       ?= 0
ifeq ($(V),1)
Q       :=
else
Q       := @
endif
RCC     ?= arm-unknown-riscos-gcc
RAR     ?= arm-unknown-riscos-ar
PUTTY   := putty-0.85
U       := upstream/$(PUTTY)
B       := build/ro
G       := build/gen

CPU     := -mlibscl -march=armv4 -mtune=cortex-a7
COMMON  := -std=gnu99 -O2 $(CPU) -DHAVE_CMAKE_H -Isrc/ro -I$(G) -I$(U) -I$(U)/terminal \
           -I$(U)/charset -MMD -MP
# Upstream code is compiled quietly: its warnings are upstream's business.
UFLAGS  := $(COMMON) -w
OFLAGS  := $(COMMON) -Wall -Wextra -Wno-unused-parameter
LDFLAGS := -mlibscl -march=armv4

p        = $(addprefix $(1)/,$(2))

# ---- portable core, per upstream library -----------------------------------
UTILS   := $(call p,utils,antispoof backend_socket_log base64_decode_atom base64_decode \
  base64_encode_atom base64_encode base64_valid bufchain buildinfo burnstr burnwcs cert-expr \
  chomp cmdline_get_passwd_input_state_new conf conf_data conf_dest conf_debug conf_launchable \
  ctrlparse ctrlset_normalise debug decode_utf8 decode_utf8_to_wchar decode_utf8_to_wide_string \
  default_description dupcat dupprintf dupstr dupwcs dupwcscat dup_mb_to_wc dup_wc_to_mb \
  encode_utf8 encode_wide_string_as_utf8 fgetline format_connection_setup_command \
  host_ca_new_free host_strchr host_strchr_internal host_strcspn host_strduptrim host_strrchr \
  key_components log_proxy_stderr make_spr_sw_abort_static marshal memory memxor nullstrcmp \
  out_of_memory parse_blocksize percent_decode percent_encode prompts ptrlen read_file_into \
  seat_connection_fatal seat_dialog_text seat_nonfatal sessprep sk_free_peer_info smemclr smemeq \
  spr_get_error_message ssh_key_clone ssh2_pick_fingerprint sshutils strbuf \
  string_length_for_printf stripctrl tempseat tree234 unicode-known unicode-norm \
  validate_manual_hostkey version wcwidth wildcard wordwrap write_c_string_literal x11authfile \
  x11authnames x11_dehexify x11_identify_auth_proto x11_make_greeting x11_parse_ip ltime)
STUBS   := $(call p,stubs,null-lp null-cipher null-key null-mac null-opener null-plug null-seat \
  null-socket)
CRYPTO  := $(call p,crypto,aes-common aes-select aes-sw aesgcm-common aesgcm-select aesgcm-sw \
  aesgcm-ref-poly arcfour argon2 bcrypt blake2 blowfish chacha20-poly1305 crc32 des \
  diffie-hellman dsa ecc-arithmetic ecc-ssh hash_simple hmac kex-hybrid mac mac_simple md5 mlkem \
  mpint ntru openssh-certs prng pubkey-pem pubkey-ppk pubkey-ssh1 rfc6979 rsa sha256-common \
  sha256-select sha256-sw sha512-common sha512-select sha512-sw sha3 sha1-common sha1-select \
  sha1-sw xdmauth)
SSH     := $(call p,ssh,bpp1 bpp2 bpp-bare ca-config censor1 censor2 common connection1 \
  connection2 crc-attack-detector gssc login1 nocompress pgssapi portfwd \
  transient-hostkey-cache transport2 verstring x11fwd zlib agentf connection1-client \
  connection2-client kex2-client mainchan sharing ssh userauth2-client)
PROXY   := $(call p,proxy,cproxy sshproxy proxy http socks4 socks5 telnet newmain local \
  interactor)
OTHERBE := $(call p,otherbackends,raw rlogin supdup telnet)
TERMINAL:= $(call p,terminal,terminal bidi lineedit)
CHARSET := $(call p,charset,fromucs localenc macenc mimeenc sbcs slookup toucs utf8 xenc)
ROOT    := sshpubk sshrand pinger logging callback timing cmdline settings errsock x11disp \
  clicons console ldisc config dialog import utils/logeventf

CORE    := $(UTILS) $(STUBS) $(CRYPTO) $(SSH) $(PROXY) $(OTHERBE) $(TERMINAL) $(CHARSET) $(ROOT)
CORE_O  := $(addprefix $(B)/up/,$(addsuffix .o,$(CORE)))

# ---- generated sources ------------------------------------------------------
GEN_O   := $(B)/gen/sbcsdat.o $(B)/gen/cmake_commit.o

$(G)/licence.h: $(U)/LICENCE $(U)/cmake/licence.cmake
	@mkdir -p $(@D)
	cmake -DLICENCE_FILE=$(U)/LICENCE -DOUTPUT_FILE=$@ -P $(U)/cmake/licence.cmake

$(G)/sbcsdat.c: $(U)/charset/sbcsgen.pl $(U)/charset/sbcs.dat
	@mkdir -p $(@D)
	perl $(U)/charset/sbcsgen.pl -o $@

# A tarball build has no git commit to ask, so use upstream's own default.
$(G)/cmake_commit.c: $(U)/cmake/gitcommit.cmake
	@mkdir -p $(@D)
	@c=$$(sed -n 's/^set(DEFAULT_COMMIT "\(.*\)")/\1/p' $<); \
	printf '/* generated by the Makefile */\n#include "putty.h"\nconst char commitid[] = "%s";\n' $$c > $@

# ---- rules ------------------------------------------------------------------
$(B)/up/%.o: $(U)/%.c $(G)/licence.h
	@mkdir -p $(@D)
	@echo "  CC  $<"
	$(Q)$(RCC) $(UFLAGS) -c -o $@ $<

$(B)/gen/%.o: $(G)/%.c
	@mkdir -p $(@D)
	@echo "  CC  $<"
	$(Q)$(RCC) $(UFLAGS) -c -o $@ $<

$(B)/ro/%.o: src/ro/%.c $(G)/licence.h
	@mkdir -p $(@D)
	@echo "  CC  $<"
	$(Q)$(RCC) $(OFLAGS) -c -o $@ $<

# be_list.c is compiled once per application, with that application's backends.
$(B)/be_plink.o: $(U)/be_list.c
	@mkdir -p $(@D)
	@echo "  CC  $<  (plink backends)"
	$(Q)$(RCC) $(UFLAGS) -DSSH=1 -DSERIAL=0 -DOTHERBACKENDS=1 -DAPPNAME=Plink -c -o $@ $<

$(B)/libputty.a: $(CORE_O) $(GEN_O)
	@echo "  AR  $@"
	$(Q)rm -f $@
	$(Q)$(RAR) rcs $@ $^

# ---- the platform layer (ours) and the generic pieces of upstream's unix/ ----
RO_SRC   := net util storage noise unicode stubs compat
RO_O     := $(addprefix $(B)/ro/,$(addsuffix .o,$(RO_SRC)))
# Unix files that are not Unix-specific at all, used as they stand.
UXGEN    := unix/uxsel unix/utils/cmdline_arg unix/utils/fontspec unix/utils/pgp_fingerprints
UXGEN_O  := $(addprefix $(B)/up/,$(addsuffix .o,$(UXGEN)))
# Stand-ins for things plink does not use (picked ahead of the real ones in the library).
PLINK_STUBS := stubs/no-agent stubs/no-gss stubs/no-lineedit stubs/no-term
PLINK_O  := $(B)/ro/plink.o $(B)/ro/console.o $(B)/be_plink.o $(RO_O) $(UXGEN_O) \
            $(addprefix $(B)/up/,$(addsuffix .o,$(PLINK_STUBS)))

$(B)/plink,ff8: $(PLINK_O) $(B)/libputty.a
	@echo "  LD  $@"
	$(Q)$(RCC) $(LDFLAGS) -o $@ $(PLINK_O) -Wl,--start-group $(B)/libputty.a -Wl,--end-group


# ---- the Wimp application ---------------------------------------------------
GUI_SRC  := roapp rowindow roseat rowimp rofont rodlg rodialog romenu roclip rocontext roconnect roconfig rocfgwin
GUI_O    := $(addprefix $(B)/ro/,$(addsuffix .o,$(GUI_SRC)))
GUI_STUBS := stubs/no-agent stubs/no-gss stubs/no-console stubs/no-dit stubs/no-printing
GUI_O    += $(addprefix $(B)/up/,$(addsuffix .o,$(GUI_STUBS)))
GUI_ALL  := $(GUI_O) $(B)/be_putty.o $(RO_O) $(UXGEN_O)

$(B)/be_putty.o: $(U)/be_list.c
	@mkdir -p $(@D)
	@echo "  CC  $<  (putty backends)"
	$(Q)$(RCC) $(UFLAGS) -DSSH=1 -DSERIAL=0 -DOTHERBACKENDS=1 -DAPPNAME=PuTTY -c -o $@ $<

$(B)/putty,ff8: $(GUI_ALL) $(B)/libputty.a
	@echo "  LD  $@"
	$(Q)$(RCC) $(LDFLAGS) -o $@ $(GUI_ALL) -Wl,--start-group $(B)/libputty.a -Wl,--end-group

# ---- diagnostics for the emulator (tests/ro/*.c, each a small stand-alone program) ----
TEST_SRC := $(wildcard tests/ro/*.c)
FF8      := ,ff8
TEST_BIN := $(patsubst tests/ro/%.c,$(B)/%$(FF8),$(TEST_SRC))

$(B)/%,ff8: tests/ro/%.c
	@mkdir -p $(@D)
	@echo "  CC  $<"
	$(Q)$(RCC) -std=gnu99 -O2 $(CPU) -Wall -o $@ $<

.PHONY: core plink putty app dist tests clean
core: $(B)/libputty.a
plink: $(B)/plink,ff8
putty: $(B)/putty,ff8
tests: $(TEST_BIN)

# ---- the application directory and the release zip -----------------------------
# The port's version (src/ro/roversion.h) names the zip and heads !Help.
VERSION := $(shell sed -n 's/^\#define RO_PORT_VERSION *"\(.*\)"/\1/p' src/ro/roversion.h)

# Files carry their RISC OS filetype as a ",xxx" suffix (understood by HostFS, and
# turned into the proper zip extra fields by tools/mkzip.py).
APPDIR := build/app/!PuTTY
app: $(B)/putty,ff8
	rm -rf build/app
	mkdir -p $(APPDIR)
	cp -r app/'!PuTTY'/. $(APPDIR)/
	cp $(B)/putty,ff8 $(APPDIR)/'!RunImage,ff8'
	python3 tools/mksprites.py $(APPDIR)/'!Sprites,ff9'
	sed -i '1s/.*/PuTTY for RISC OS $(VERSION)/' $(APPDIR)/'!Help,fff'

dist: app
	cp README.md build/ReadMe,fff
	cp LICENSE build/Licence,fff
	python3 tools/mkzip.py build/PuTTY-$(VERSION).zip $(APPDIR) build/ReadMe,fff build/Licence,fff

clean:
	rm -rf build

-include $(shell find $(B) -name '*.d' 2>/dev/null)
