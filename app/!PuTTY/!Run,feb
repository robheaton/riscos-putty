| !Run file for !PuTTY
Set PuTTY$Dir <Obey$Dir>
IconSprites <Obey$Dir>.!Sprites
| the command-line tools (puttygen, psftp, pscp) can then be run by name
Set PuTTY$Tools <Obey$Dir>.Tools.
If "<PuTTY$OnPath>" = "" Then Set Run$Path <Run$Path>,<PuTTY$Tools>
Set PuTTY$OnPath 1
WimpSlot -min 6144k -max 16384k
Run <PuTTY$Dir>.!RunImage %*0
